# ============================================
# WP-DB MCP Server — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Then update ~/.claude.json → mcpServers → wp-db → env
# to match these values.
#
# Restart Claude Code after making changes.
# ============================================

# --- Database Connection ---
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_NAME=wordpress
WP_TABLE_PREFIX=wp_

# ============================================
# EXAMPLES
# ============================================
#
# --- Local WAMP (e.g. log2024) ---
# WP_DB_HOST=localhost
# WP_DB_PORT=3306
# WP_DB_USER=root
# WP_DB_PASSWORD=
# WP_DB_NAME=log2024
# WP_TABLE_PREFIX=wp_
#
# --- Remote / Staging ---
# WP_DB_HOST=db.staging.example.com
# WP_DB_PORT=3306
# WP_DB_USER=staging_user
# WP_DB_PASSWORD=s3cur3P@ss
# WP_DB_NAME=staging_wp
# WP_TABLE_PREFIX=wp_
#
# --- Custom Table Prefix ---
# WP_DB_HOST=localhost
# WP_DB_PORT=3306
# WP_DB_USER=root
# WP_DB_PASSWORD=
# WP_DB_NAME=mysite_db
# WP_TABLE_PREFIX=mysite_
#
# --- Remote via SSH Tunnel ---
# First run: ssh -L 3308:localhost:3306 stagel_27279@angelo-osl.servebolt.cloud
# Then use:
# WP_DB_HOST=127.0.0.1
# WP_DB_PORT=3308
# WP_DB_USER=from_wp_config
# WP_DB_PASSWORD=from_wp_config
# WP_DB_NAME=from_wp_config
# WP_TABLE_PREFIX=wp_

# ============================================
# GitHub MCP Server
# ============================================
# Used by: claude mcp add -s user github -- npx @modelcontextprotocol/server-github
# Get token: https://github.com/settings/tokens
# Scopes needed: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
